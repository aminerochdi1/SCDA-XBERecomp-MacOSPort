#import <Metal/Metal.h>
#import <QuartzCore/CAMetalLayer.h>
#include <SDL3/SDL.h>
#include <SDL3/SDL_metal.h>

#include <algorithm>
#include <cstdint>
#include <memory>
#include <vector>

#include <imgui.h>
#include <backends/imgui_impl_metal.h>
#include <backends/imgui_impl_sdl3.h>
#include <mutex>

#include "app/app.h"
#include "core/log.h"
#include "gpu/backend.h"
#include "kernel/kernel.h"
#include "kernel/memory.h"

namespace gpu {

class MetalBackend final : public Backend {
public:
    MetalBackend() = default;
    ~MetalBackend() override {
        if (metal_view_) {
            SDL_Metal_DestroyView(metal_view_);
        }
    }

    bool Init(uint32_t width, uint32_t height) override {
        @autoreleasepool {
            device_ = MTLCreateSystemDefaultDevice();
            if (!device_) {
                LOGE("Metal: Failed to create default Metal device");
                return false;
            }

            queue_ = [device_ newCommandQueue];
            if (!queue_) {
                LOGE("Metal: Failed to create Metal command queue");
                return false;
            }

            SDL_Window* window = static_cast<SDL_Window*>(app::Window());
            if (!window) {
                LOGE("Metal: No SDL window available");
                return false;
            }

            metal_view_ = SDL_Metal_CreateView(window);
            if (!metal_view_) {
                LOGE("Metal: Failed to create SDL_MetalView: %s", SDL_GetError());
                return false;
            }

            layer_ = (__bridge CAMetalLayer*)SDL_Metal_GetLayer(metal_view_);
            layer_.device = device_;
            layer_.pixelFormat = MTLPixelFormatBGRA8Unorm;
            layer_.framebufferOnly = YES;

            int w = 0, h = 0;
            SDL_GetWindowSizeInPixels(window, &w, &h);
            layer_.drawableSize = CGSizeMake(w, h);

            ImGui_ImplMetal_Init(device_);

            LOGI("Metal initialized: %s, viewport %ux%u, drawable %dx%d",
                 [device_.name UTF8String], width, height, w, h);
            return true;
        }
    }

    void Clear(const State& s, uint32_t count, const uint8_t* rects, uint32_t flags, uint32_t color, float z,
               uint32_t stencil) override {
        clear_color_ = color;
        clear_z_ = z;
        clear_stencil_ = stencil;
        has_clear_ = true;
    }

    void Draw(const State& s, uint32_t prim, uint32_t start, uint32_t count, const uint8_t* indices) override {
    }

    void Copy(const Surface& src, const Surface& dst, uint32_t count, uint32_t src_rects_va,
              uint32_t dst_points_va) override {
    }

    void Present(const Surface& front, bool pillarbox) override {
        @autoreleasepool {
            id<CAMetalDrawable> drawable = [layer_ nextDrawable];
            if (!drawable) return;

            MTLRenderPassDescriptor* passDesc = [MTLRenderPassDescriptor renderPassDescriptor];
            passDesc.colorAttachments[0].texture = drawable.texture;
            passDesc.colorAttachments[0].loadAction = MTLLoadActionClear;
            passDesc.colorAttachments[0].storeAction = MTLStoreActionStore;

            float a = ((clear_color_ >> 24) & 0xFF) / 255.0f;
            float r = ((clear_color_ >> 16) & 0xFF) / 255.0f;
            float g = ((clear_color_ >> 8) & 0xFF) / 255.0f;
            float b = (clear_color_ & 0xFF) / 255.0f;
            passDesc.colorAttachments[0].clearColor = MTLClearColorMake(r, g, b, a);

            id<MTLCommandBuffer> cmd = [queue_ commandBuffer];
            id<MTLRenderCommandEncoder> enc = [cmd renderCommandEncoderWithDescriptor:passDesc];

            // Render ImGui UI on top
            {
                std::lock_guard lock(app::UiLock());
                ImGui_ImplMetal_NewFrame(passDesc);
                ImGui_ImplSDL3_NewFrame();
                ImGui::NewFrame();
                app::DrawUi();
                ImGui::Render();
                ImGui_ImplMetal_RenderDrawData(ImGui::GetDrawData(), cmd, enc);
            }

            [enc endEncoding];
            [cmd presentDrawable:drawable];
            [cmd commit];
        }
    }

    void Sync(uint32_t data_va, uint32_t size) override {}
    void SyncLate(uint32_t data_va) override {}
    void Flush() override {}
    void SetGamma(const uint8_t* ramp) override {}

private:
    id<MTLDevice> device_ = nil;
    id<MTLCommandQueue> queue_ = nil;
    CAMetalLayer* layer_ = nil;
    SDL_MetalView metal_view_ = nullptr;
    uint32_t clear_color_ = 0xFF000000;
    float clear_z_ = 1.0f;
    uint32_t clear_stencil_ = 0;
    bool has_clear_ = false;
};

std::unique_ptr<Backend> CreateBackend() {
    return std::make_unique<MetalBackend>();
}

}  // namespace gpu
